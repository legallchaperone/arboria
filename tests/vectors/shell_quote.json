          "a\"b"
        ]
      },
      "output": {
        "join": "'a\"b'",
        "quoted": [
          "'a\"b'"
        ]
      }
    },
    {
      "id": "single-quote",
      "input": {
        "argv": [
          "it's"
        ]
      },
      "output": {
        "join": "'it'\"'\"'s'",
        "quoted": [
          "'it'\"'\"'s'"
        ]
      }
    },
    {
      "id": "only-quote",
      "input": {
        "argv": [
          "'"
        ]
      },
      "output": {
        "join": "''\"'\"''",
        "quoted": [
          "''\"'\"''"
        ]
      }
    },
    {
      "id": "unicode",
      "input": {
        "argv": [
          "--name=学习率"
        ]
      },
      "output": {
        "join": "'--name=学习率'",
        "quoted": [
          "'--name=学习率'"
        ]
      }
    },
    {
      "id": "safe-punct",
      "input": {
        "argv": [
          "a@b%c+d=e:f,g.h/i-j_k"
        ]
      },
      "output": {
        "join": "a@b%c+d=e:f,g.h/i-j_k",
        "quoted": [
          "a@b%c+d=e:f,g.h/i-j_k"
        ]
      }
    },
    {
      "id": "glob",
      "input": {
        "argv": [
          "*.py",
          "a?b",
          "[x]"
        ]
      },
      "output": {
        "join": "'*.py' 'a?b' '[x]'",
        "quoted": [
