{
  "cases": [
    {
      "id": "simple",
      "input": {
        "argv": [
          "python",
          "train.py"
        ]
      },
      "output": {
        "join": "python train.py",
        "quoted": [
          "python",
          "train.py"
        ]
      }
    },
    {
      "id": "hydra",
      "input": {
        "argv": [
          "python",
          "train.py",
          "optim.lr=0.0003"
        ]
      },
      "output": {
        "join": "python train.py optim.lr=0.0003",
        "quoted": [
          "python",
          "train.py",
          "optim.lr=0.0003"
        ]
      }
    },
    {
      "id": "spaces",
      "input": {
        "argv": [
          "python",
          "-c",
          "print('hi there')"
        ]
      },
      "output": {
        "join": "python -c 'print('\"'\"'hi there'\"'\"')'",
        "quoted": [
          "python",
          "-c",
          "'print('\"'\"'hi there'\"'\"')'"
        ]
      }
    },
    {
      "id": "empty-arg",
      "input": {
        "argv": [
          "echo",
          ""
        ]
      },
      "output": {
        "join": "echo ''",
        "quoted": [
          "echo",
          "''"
        ]
      }
    },
    {
      "id": "dollar",
      "input": {
        "argv": [
          "echo",
          "$HOME",
          "${USER}"
        ]
      },
      "output": {
        "join": "echo '$HOME' '${USER}'",
        "quoted": [
          "echo",
          "'$HOME'",
          "'${USER}'"
        ]
      }
    },
    {
      "id": "double-quote",
      "input": {
