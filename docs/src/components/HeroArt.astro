---
// A quiet drawing of an idea tree, in the dashboard's language: one lane per idea
// over time, forks from a run, run ticks, one run waiting for approval.
---

<svg class="hero-art" viewBox="0 0 420 280" role="img" aria-labelledby="hero-art-title">
	<title id="hero-art-title">idea 树：每个 idea 一行，从某个 run 分叉，竖条是 run</title>
	<g class="grid">
		<line x1="40" y1="24" x2="40" y2="256"></line>
		<line x1="150" y1="24" x2="150" y2="256"></line>
		<line x1="260" y1="24" x2="260" y2="256"></line>
		<line x1="370" y1="24" x2="370" y2="256"></line>
	</g>
	<g class="lane">
		<line x1="30" y1="64" x2="396" y2="64"></line>
		<line x1="128" y1="120" x2="396" y2="120"></line>
		<line x1="228" y1="176" x2="330" y2="176"></line>
		<line x1="196" y1="232" x2="396" y2="232"></line>
	</g>
	<g class="fork">
		<path d="M96 64 C 104 108, 112 120, 128 120"></path>
		<path d="M200 120 C 206 164, 214 176, 228 176"></path>
	</g>
	<path class="seed-link" d="M150 232 H 196"></path>
	<circle class="seed" cx="146" cy="232" r="5"></circle>
	<g class="start">
		<circle cx="30" cy="64" r="4"></circle>
		<circle cx="128" cy="120" r="4"></circle>
		<circle cx="228" cy="176" r="4"></circle>
		<circle cx="196" cy="232" r="4"></circle>
	</g>
	<g class="tick">
		<rect x="58" y="55" width="4" height="18" rx="2"></rect>
		<rect x="94" y="55" width="4" height="18" rx="2"></rect>
		<rect x="176" y="55" width="4" height="18" rx="2"></rect>
		<rect x="160" y="111" width="4" height="18" rx="2"></rect>
		<rect x="198" y="111" width="4" height="18" rx="2"></rect>
		<rect x="286" y="111" width="4" height="18" rx="2"></rect>
		<rect x="262" y="167" width="4" height="18" rx="2"></rect>
		<rect x="236" y="223" width="4" height="18" rx="2"></rect>
		<rect x="318" y="223" width="4" height="18" rx="2"></rect>
	</g>
	<rect class="tick bad" x="300" y="167" width="4" height="18" rx="2"></rect>
	<rect class="tick pending" x="352" y="111" width="4" height="18" rx="2"></rect>
	<circle class="pending-halo" cx="354" cy="120" r="14"></circle>
	<g class="end">
		<circle cx="396" cy="64" r="3"></circle>
		<circle cx="396" cy="120" r="3"></circle>
		<circle cx="396" cy="232" r="3"></circle>
	</g>
</svg>

<style>
	.hero-art {
		display: block;
		width: 100%;
		height: auto;
	}
	.grid line {
		stroke: var(--arb-line-soft);
		stroke-width: 1;
		stroke-dasharray: 2 5;
	}
	.lane line {
		stroke: var(--arb-line);
		stroke-width: 8;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.fork path {
		fill: none;
		stroke: var(--arb-faint);
		stroke-width: 1.5;
	}
	.seed-link {
		fill: none;
		stroke: var(--arb-faint);
		stroke-width: 1.5;
		stroke-dasharray: 3 4;
	}
	.seed {
		fill: var(--arb-surface);
		stroke: var(--arb-ok);
		stroke-width: 2;
	}
	.start circle {
		fill: var(--arb-accent);
	}
	.tick rect,
	rect.tick {
		fill: var(--arb-faint);
	}
	rect.tick.bad {
		fill: var(--arb-bad);
	}
	rect.tick.pending {
		fill: var(--arb-warn);
	}
	.pending-halo {
		fill: none;
		stroke: var(--arb-warn);
		stroke-width: 1.25;
		opacity: 0.5;
	}
	.end circle {
		fill: var(--arb-line);
	}
</style>
