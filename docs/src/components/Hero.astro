---
// Starlight's Hero, rearranged for Arboria: text on the left, the idea-tree
// drawing on the right; the drawing is inline SVG so it follows the theme.
import { LinkButton } from '@astrojs/starlight/components';
import HeroArt from './HeroArt.astro';

const PAGE_TITLE_ID = '_top'; // Starlight's id for the page title (skip link target)
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero not-content">
	<div class="copy">
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	<div class="art">
		<HeroArt />
	</div>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: 100%;
		gap: 2rem;
		align-items: center;
		padding-block: 2.5rem 1.5rem;
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 1.6rem + 3.6vw, 3.75rem);
		line-height: 1.1;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	.tagline {
		margin: 0;
		max-width: 30rem;
		font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.3125rem);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 0.25rem;
	}
	.art {
		max-width: 26rem;
		width: 100%;
		margin-inline: auto;
	}
	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 6fr 5fr;
			gap: 3rem;
			padding-block: 4.5rem 3rem;
		}
		.art {
			margin-inline: 0 auto;
		}
	}
</style>
