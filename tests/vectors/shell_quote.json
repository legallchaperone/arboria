    {
      "id": "dash-flags",
      "input": {
        "argv": [
          "--lr",
          "1e-4",
          "-v"
        ]
      },
      "output": {
        "join": "--lr 1e-4 -v",
        "quoted": [
          "--lr",
          "1e-4",
          "-v"
        ]
      }
    }
  ],
  "name": "shell_quote",
  "notes": "Python's shlex.join / shlex.quote, which render_sbatch uses for the command line and the ARBORIA_RUN_ID/WANDB_ID/IDEA exports. quote(): '' for the empty string; unchanged if every char is ASCII [A-Za-z0-9_@%+=:,./-]; else wrapped in single quotes with each ' written as '\"'\"'. Output {join, quoted}.",
  "source": "shlex.join",
  "version": 1
}
