{
  "cases": [
    {
      "id": "flowchart",
      "input": {
        "src": "flowchart TD\n  A[数据] --> B[训练]\n  B --> C{评估}"
      },
      "output": "flowchart TD\n  A[数据] --> B[训练]\n  B --> C{评估}"
    },
    {
      "id": "graph-lr",
      "input": {
        "src": "graph LR\nA-->B"
      },
      "output": "graph LR\nA-->B"
    },
    {
      "id": "comment-first",
      "input": {
        "src": "%% overview\nsequenceDiagram\nA->>B: hi"
      },
      "output": "%% overview\nsequenceDiagram\nA->>B: hi"
    },
    {
      "id": "blank-first",
      "input": {
        "src": "\n\n  classDiagram\n  A <|-- B"
      },
      "output": "classDiagram\n  A <|-- B"
    },
    {
      "id": "br-ok",
      "input": {
        "src": "flowchart TD\nA[a<br>b<br/>c]"
      },
      "output": "flowchart TD\nA[a<br>b<br/>c]"
    },
    {
      "id": "br-upper",
      "input": {
        "src": "graph TD\nA[a<BR />b]"
      },
      "output": "graph TD\nA[a<BR />b]"
    },
    {
      "id": "tab-ok",
      "input": {
        "src": "graph TD\n\tA-->B"
      },
      "output": "graph TD\n\tA-->B"
    },
    {
      "id": "stripped",
      "input": {
        "src": "  graph TD\nA-->B  \n"
      },
      "output": "graph TD\nA-->B"
    },
    {
      "error": "ArbError: mermaid: control characters are not allowed",
      "id": "err-crlf",
      "input": {
        "src": "graph TD\r\nA-->B\r\n"
      }
    },
    {
      "id": "arrow-not-tag",
      "input": {
        "src": "graph TD\nA -- text --> B\nC<-->D"
      },
      "output": "graph TD\nA -- text --> B\nC<-->D"
    },
    {
      "error": "ArbError: mermaid must not be empty",
      "id": "err-empty",
      "input": {
        "src": ""
      }
    },
    {
      "error": "ArbError: mermaid must start with a diagram type (flowchart, graph, sequenceDiagram, classDiagram, classDiagram-v2, stateDiagram, …), got 'A-->B'",
      "id": "err-no-type",
      "input": {
        "src": "A-->B"
      }
    },
    {
      "error": "ArbError: mermaid must start with a diagram type (flowchart, graph, sequenceDiagram, classDiagram, classDiagram-v2, stateDiagram, …), got 'chart'",
      "id": "err-unknown-type",
      "input": {
        "src": "chart TD\nA-->B"
      }
    },
    {
      "error": "ArbError: mermaid must start with a diagram type (flowchart, graph, sequenceDiagram, classDiagram, classDiagram-v2, stateDiagram, …), got ''",
      "id": "err-only-comment",
      "input": {
        "src": "%% nothing"
      }
    },
    {
      "error": "ArbError: mermaid: no %%{init}%% directives (theme and security are arb's)",
      "id": "err-init",
      "input": {
        "src": "%%{init: {'theme': 'dark'}}%%\ngraph TD"
      }
    },
    {
      "error": "ArbError: mermaid: no %%{init}%% directives (theme and security are arb's)",
      "id": "err-init-later",
      "input": {
        "src": "graph TD\nA-->B\n%%{init: {}}%%"
      }
    },
    {
      "error": "ArbError: mermaid: no click handlers or links ('click A callback')",
      "id": "err-click",
      "input": {
        "src": "graph TD\nA-->B\nclick A callback"
      }
    },
    {
      "error": "ArbError: mermaid: no click handlers or links ('click A href \"x\"')",
      "id": "err-click-indented",
      "input": {
        "src": "graph TD\n   click A href \"x\""
      }
    },
    {
      "error": "ArbError: mermaid: no click handlers or links ('A[HREF]')",
      "id": "err-href",
      "input": {
        "src": "graph TD\nA[HREF]"
      }
    },
    {
      "error": "ArbError: mermaid: no click handlers or links ('A[JavaScript:alert]')",
      "id": "err-javascript",
      "input": {
        "src": "graph TD\nA[JavaScript:alert]"
      }
    },
    {
      "error": "ArbError: mermaid: no HTML in labels (only <br>); write plain text",
      "id": "err-html",
      "input": {
        "src": "graph TD\nA[<b>bold</b>]"
      }
    },
    {
      "error": "ArbError: mermaid: no HTML in labels (only <br>); write plain text",
      "id": "err-html-spaced",
      "input": {
        "src": "graph TD\nA[< img>]"
      }
    },
    {
      "error": "ArbError: mermaid: no HTML in labels (only <br>); write plain text",
      "id": "err-html-comment",
      "input": {
        "src": "graph TD\nA[<!-- x -->]"
      }
    },
    {
      "error": "ArbError: mermaid: control characters are not allowed",
      "id": "err-control",
      "input": {
        "src": "graph TD\nA\u0007-->B"
      }
    },
    {
      "error": "ArbError: mermaid: control characters are not allowed",
      "id": "err-del",
      "input": {
        "src": "graph TD\nA"
      }
    },
    {
      "error": "ArbError: mermaid is too long: 8001 chars (max 8000); shorten it",
      "id": "err-over-limit",
      "input": {
        "src": "graph TD\"
      }
    },
    {
      "id": "at-limit",
      "input": {
        "src": "graph TD\"
      },
      "output": "graph TD\"
    },
    {
      "error": "ArbError: mermaid must be a string",
      "id": "err-not-string",
      "input": {
        "src": 5
      }
    },
    {
      "id": "clicked-word-ok",
      "input": {
        "src": "graph TD\nclicked-->B"
      },
      "output": "graph TD\nclicked-->B"
    }
  ],
  "name": "check_mermaid",
  "notes": "The map view's Mermaid source: <= 8000 chars (stripped), no control chars except \\t \\n, first non-empty non-%% line starts with a diagram type, no %%{ directives, no click/href/javascript:, no HTML tags except <br>.",
  "source": "arboria.inspection.check_mermaid",
  "version": 1
}
