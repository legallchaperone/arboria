---
// Starlight's Hero, rearranged for Arboria: a short line of what it is, the title,
// the subtitle and the buttons, then the contrast picture (HeroContrast) below.
import { LinkButton } from '@astrojs/starlight/components';
import HeroContrast from './HeroContrast.astro';

const PAGE_TITLE_ID = '_top'; // Starlight's id for the page title (skip link target)
const { entry, lang: pageLang } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const lang = pageLang.startsWith('en') ? 'en' : 'zh';
const kicker = lang === 'en' ? 'Arboria · ML research with an agent' : 'Arboria · 和 agent 一起做 ML 研究';
---

<div class="hero not-content">
	<div class="copy">
		<p class="kicker">{kicker}</p>
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	<HeroContrast lang={lang} />
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding-block: 0.5rem 2.5rem;
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.kicker {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--arb-accent);
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.2rem + 2.8vw, 3.25rem);
		line-height: 1.2;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	/* the title breaks at its comma, never inside a half */
	h1 :global(span) {
		display: inline-block;
	}
	.tagline {
		margin: 0;
		max-width: 44rem;
		font-size: clamp(1rem, 0.94rem + 0.3vw, 1.125rem);
		line-height: 1.8;
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 0.5rem;
	}
	@media (min-width: 50rem) {
		.hero {
			gap: 2.5rem;
			padding-block: 0.75rem 3rem;
		}
	}
</style>
