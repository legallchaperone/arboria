---
// The landing page below the hero: four screens (one heading, two lines, pictures of
// real output from demo data), then a small footer. Copy in Chinese and English.
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import ApprovalFlow from './ApprovalFlow.astro';
import plot from '../assets/shots/plot.webp';
import cmdBuiltin from '../assets/shots/cmd-builtin.webp';
import cmdMine from '../assets/shots/cmd-mine.webp';
import nbSvd from '../assets/shots/nb-svd.webp';
import nbCard from '../assets/shots/nb-card.webp';
import dashLight from '../assets/shots/dashboard-light.webp';
import dashDark from '../assets/shots/dashboard-dark.webp';
// what a new agent session is handed: real `arb hook session-start` output of a demo project
import sessionStart from '../assets/session-start.txt?raw';

interface Props {
	lang?: 'zh' | 'en';
}
const { lang = 'zh' } = Astro.props;
const zh = lang === 'zh';
const docs = (p: string) => `/${p}/`; // the docs themselves are Chinese only

// the long rules paragraph at the end is cut to its first sentence
const hookLines = sessionStart
	.trimEnd()
	.split('\n')
	.map((line) => (line.startsWith('Ledger rules:') ? line.slice(0, line.indexOf('`arb`.') + 6) + ' …' : line));
const lineClass = (line: string) =>
	line.startsWith('[arboria]')
		? 'h'
		: /^(命令待办|待你批准)/.test(line)
			? 'w'
			: /^(Ledger rules|看板)/.test(line)
				? 'd'
				: /^\s{4}/.test(line)
					? 'm'
					: '';

const c = zh
	? {
			bench: {
				kicker: '你的工作台',
				title: '常用的分析，写一行就有',
				body: '对比曲线、看两个 run 差在哪、算力花在了哪，都是 notebook 里的一行，结果就在下面。',
				plot: '一行画出几个 run 的同一条曲线。',
				table: '内置的分析，lab.commands() 列出全部。',
				link: ['notebook 与 lab', 'guides/notebook'],
			},
			mine: {
				kicker: '你的命令',
				title: '缺一个分析？也写一行',
				body: '没有的命令交给 agent：它写一次，cell 自动重跑；之后它就是你的命令，不花 token，也不用再解释。',
				diff: '别的 notebook AI 改你的 cell；这里 agent 不碰 notebook，交给你的是一个函数。',
				first: '第一次：命令还不存在，交给 agent。',
				after: '之后：agent 写好的命令带着版本，和内置的一样调用。',
				link: ['自定义命令', 'guides/commands'],
			},
			resume: {
				kicker: '换会话',
				title: '不用重讲一遍',
				body: '换一个会话，idea、run 和待办都还在，agent 一开始就看得到。等你处理的事，一屏看完。',
				term: '新会话开头，agent 自动收到这一屏',
				termCap: '演示项目的真实输出，最后一段规则从略。',
				dash: 'arb ui：等你处理的事、idea 怎么分叉、算力花在哪。只读。',
				link: ['和 Claude Code 一起用', 'guides/claude-code'],
			},
			approve: {
				kicker: '批准',
				title: '上集群，你说了算',
				body: '一行发起，先拿到一张单子；你在自己的终端里签了字，作业才提交。之后排队、计费、分段、出错提前取消，都不用你管。',
				card: 'lab.run 只给你一张单子：代码、资源、估计花费、预算。',
				link: ['提交与批准', 'guides/submit'],
			},
			foot: {
				seed: {
					title: '还没有仓库？先记成种子',
					body: '在仓库外运行 arb idea new，想法连同一个 notebook 先放在 ~/arboria；想清楚了再种进仓库。',
					link: ['种子园', 'guides/seeds'],
				},
				not: {
					title: '它不是什么',
					items: [
						['不是 wandb', '曲线还在 wandb。arb 记的是为什么跑、用的哪版代码、谁批准的、花了多少，并链到那个 wandb run。'],
						['不是 MLflow 一类的追踪器', '它不存指标和模型，管的是从想法到上集群的这一段。'],
						['不是 Jupyter AI 一类', '那些让 AI 改你的 cell；这里 agent 从不碰 notebook。'],
					],
				},
				guard: {
					title: '护栏，不是沙箱',
					body: '它防的是 agent 顺手照做不该做的事，不防以你的身份在同一台机器上运行的蓄意对手。',
					link: ['安全模型', 'reference/security'],
				},
				end: '装好 arb，在任意 git 仓库里建一个 idea 和它的 notebook。',
				start: '快速开始',
				concepts: '核心概念',
			},
		}
	: {
			bench: {
				kicker: 'Your bench',
				title: 'Common analyses are one line',
				body: 'Compare curves, see how two runs differ, see where the compute went: each is one line in the notebook, with the result right below.',
				plot: 'One line draws the same curve for several runs.',
				table: 'Built-in analyses; lab.commands() lists them all.',
				link: ['Notebook and lab (Chinese)', 'guides/notebook'],
			},
			mine: {
				kicker: 'Your commands',
				title: 'Missing an analysis? One line too',
				body: 'A command that does not exist goes to the agent: it writes it once and the cell re-runs. From then on it is your command: no tokens, no re-explaining.',
				diff: 'Other notebook AIs edit your cells; here the agent never touches the notebook. It hands you a function.',
				first: 'The first call: no such command yet, so it goes to the agent.',
				after: 'Afterwards: the agent’s commands carry a version and are called like the built-in ones.',
				link: ['Custom commands (Chinese)', 'guides/commands'],
			},
			resume: {
				kicker: 'New session',
				title: 'No re-explaining',
				body: 'Switch sessions and the ideas, runs and todos are still there; the agent sees them from the start. What waits for you fits on one screen.',
				term: 'What a new agent session is handed',
				termCap: 'Real output from a demo project; the closing rules are cut.',
				dash: 'arb ui: what waits for you, how ideas branched, where the compute went. Read-only.',
				link: ['With Claude Code (Chinese)', 'guides/claude-code'],
			},
			approve: {
				kicker: 'Approval',
				title: 'On the cluster, you decide',
				body: 'One line starts it and you get a slip; the job is submitted only after you sign it in your own terminal. Queueing, billing, segments and cancelling on errors are handled from there.',
				card: 'lab.run only gives you a slip: code, resources, estimated cost, budget.',
				link: ['Submitting and approving (Chinese)', 'guides/submit'],
			},
			foot: {
				seed: {
					title: 'No repo yet? Keep it as a seed',
					body: 'Run arb idea new outside a repo: the idea and a notebook wait in ~/arboria until you plant it in a repo.',
					link: ['Seeds (Chinese)', 'guides/seeds'],
				},
				not: {
					title: 'What it is not',
					items: [
						['Not wandb', 'Curves stay in wandb. arb records why a run happened, which code, who approved it and what it cost, and links the wandb run.'],
						['Not an MLflow-style tracker', 'It stores no metrics or models; it covers the way from an idea to the cluster.'],
						['Not Jupyter AI and the like', 'Those let the AI edit your cells; here the agent never touches the notebook.'],
					],
				},
				guard: {
					title: 'Guard rails, not a sandbox',
					body: 'They stop an agent from going along with a stray instruction, not a deliberate adversary running as you on the same machine.',
					link: ['Security (Chinese)', 'reference/security'],
				},
				end: 'Install arb and create an idea and its notebook in any git repository. The documentation is in Chinese.',
				start: 'Quick start (Chinese)',
				concepts: 'Concepts (Chinese)',
			},
		};

const col = '(min-width: 72rem) 40rem, (min-width: 60rem) 56vw, 94vw';
---

<div class="landing not-content" lang={zh ? 'zh-CN' : 'en'}>
	<section class="block">
		<header>
			<p class="kicker">{c.bench.kicker}</p>
			<h2>{c.bench.title}</h2>
			<p class="body">{c.bench.body}</p>
			<a class="more" href={docs(c.bench.link[1])}>{c.bench.link[0]} →</a>
		</header>
		<div class="figs">
			<figure class="shot">
				<div class="cell">
					<pre class="code"><span class="f">lab.plot</span>([<span class="s">"r001"</span>, <span class="s">"r002"</span>, <span class="s">"r004"</span>], <span class="s">"val/loss"</span>)</pre>
					<Image src={plot} widths={[640, 960, 1300]} sizes={col} alt={zh ? 'lab.plot 的输出：r001、r002、r004 三个 run 的 val/loss 曲线画在一起' : 'Output of lab.plot: the val/loss curves of r001, r002 and r004 in one chart'} />
				</div>
				<figcaption>{c.bench.plot}</figcaption>
			</figure>
			<figure class="shot">
				<Image class="framed" src={cmdBuiltin} widths={[640, 960, 1304]} sizes={col} alt={zh ? '命令表里的内置分析：runs、compare、plot、diff、spend，各一句说明' : 'Built-in analyses in the command table: runs, compare, plot, diff, spend, each with a one-line description'} />
				<figcaption>{c.bench.table}</figcaption>
			</figure>
		</div>
	</section>

	<section class="block">
		<header>
			<p class="kicker">{c.mine.kicker}</p>
			<h2>{c.mine.title}</h2>
			<p class="body">{c.mine.body}</p>
			<p class="body diff">{c.mine.diff}</p>
			<a class="more" href={docs(c.mine.link[1])}>{c.mine.link[0]} →</a>
		</header>
		<div class="figs">
			<figure class="shot">
				<Image class="framed" src={nbSvd} widths={[819]} sizes={col} alt={zh ? 'notebook 里调用 lab.svd，命令还不存在，cell 显示已交给 Claude（t001），写好后会自动重跑' : 'Calling lab.svd in the notebook: the command does not exist yet, so the cell says it was handed over (t001) and will re-run'} />
				<figcaption>{c.mine.first}</figcaption>
			</figure>
			<p class="then" aria-hidden="true">↓</p>
			<figure class="shot">
				<Image class="framed" src={cmdMine} widths={[640, 960, 1509]} sizes={col} alt={zh ? '命令表里的项目命令 attn_entropy、svd 和全局命令 loss_curve，各带版本号和说明' : 'Project commands attn_entropy and svd and the global command loss_curve in the command table, each with a version and a description'} />
				<figcaption>{c.mine.after}</figcaption>
			</figure>
		</div>
	</section>

	<section class="block">
		<header>
			<p class="kicker">{c.resume.kicker}</p>
			<h2>{c.resume.title}</h2>
			<p class="body">{c.resume.body}</p>
			<a class="more" href={docs(c.resume.link[1])}>{c.resume.link[0]} →</a>
			<figure class="shot dash">
				<Image class="arb-light-only" src={dashLight} widths={[640, 960, 1250]} sizes="(min-width: 60rem) 26rem, 94vw" alt={zh ? 'Arboria 看板：顶部是需要你处理的数量、进行中的 idea、活跃作业和已用 SU；左边是待你处理，右边是 idea 树和 idea 详情' : 'The Arboria dashboard: counts on top, what needs you on the left, the idea tree and idea details on the right'} />
				<Image class="arb-dark-only" src={dashDark} widths={[640, 960, 1250]} sizes="(min-width: 60rem) 26rem, 94vw" alt="" />
				<figcaption>{c.resume.dash}</figcaption>
			</figure>
		</header>
		<div class="figs">
			<figure class="term">
				<div class="term-bar"><span class="dots"><i></i><i></i><i></i></span><span>{c.resume.term}</span></div>
				<pre>{hookLines.map((line) => <span class={lineClass(line)}>{line + '\n'}</span>)}</pre>
				<figcaption>{c.resume.termCap}</figcaption>
			</figure>
		</div>
	</section>

	<section class="block">
		<header>
			<p class="kicker">{c.approve.kicker}</p>
			<h2>{c.approve.title}</h2>
			<p class="body">{c.approve.body}</p>
			<a class="more" href={docs(c.approve.link[1])}>{c.approve.link[0]} →</a>
		</header>
		<div class="figs">
			<figure class="shot">
				<Image class="framed" src={nbCard} widths={[640, 960, 1094]} sizes={col} alt={zh ? 'lab.run 的输出：r003 待批准，下面展开的单子列出检查、资源、估计、预算和哈希' : 'Output of lab.run: r003 awaiting approval, with the slip expanded: checks, resources, estimate, budget and hash'} />
				<figcaption>{c.approve.card}</figcaption>
			</figure>
		</div>
		<div class="wide">
			<ApprovalFlow lang={lang} />
		</div>
	</section>

	<footer class="foot">
		<div class="tiles">
			<div class="tile">
				<h3>{c.foot.seed.title}</h3>
				<p>{c.foot.seed.body}</p>
				<a class="more" href={docs(c.foot.seed.link[1])}>{c.foot.seed.link[0]} →</a>
			</div>
			<div class="tile">
				<h3>{c.foot.not.title}</h3>
				<ul>
					{
						c.foot.not.items.map(([head, text]) => (
							<li>
								<b>{head}</b>{zh ? '：' : ': '}{text}
							</li>
						))
					}
				</ul>
			</div>
			<div class="tile">
				<h3>{c.foot.guard.title}</h3>
				<p>{c.foot.guard.body}</p>
				<a class="more" href={docs(c.foot.guard.link[1])}>{c.foot.guard.link[0]} →</a>
			</div>
		</div>
		<div class="end">
			<p>{c.foot.end}</p>
			<div class="actions">
				<LinkButton href={docs('start/quickstart')} icon="right-arrow">{c.foot.start}</LinkButton>
				<LinkButton href={docs('start/concepts')} variant="minimal">{c.foot.concepts}</LinkButton>
			</div>
		</div>
	</footer>
</div>

<style>
	.landing {
		display: flex;
		flex-direction: column;
	}
	.block {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.75rem;
		padding-block: 3.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	@media (min-width: 60rem) {
		.block {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 3rem;
			padding-block: 4.5rem;
		}
	}
	header {
		max-width: 36rem;
	}
	.kicker {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--arb-accent);
	}
	h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.body {
		margin: 0;
		font-size: var(--sl-text-base);
		line-height: 1.8;
		color: var(--sl-color-gray-2);
	}
	.body.diff {
		margin-top: 0.75rem;
		padding-left: 0.75rem;
		border-left: 2px solid var(--arb-accent);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.more {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}
	.figs {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: 0;
	}
	.shot {
		margin: 0;
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.shot :global(img.framed),
	.shot :global(.arb-light-only),
	.shot :global(.arb-dark-only),
	.cell {
		border: 1px solid var(--arb-line);
		border-radius: 0.6rem;
		box-shadow: var(--arb-shot-shadow);
		background: #fff;
	}
	.cell {
		overflow: hidden;
	}
	.cell :global(img) {
		padding: 0.5rem 0.75rem 0.25rem;
	}
	.code {
		margin: 0;
		padding: 0.5rem 0.9rem;
		border-bottom: 1px solid #e7ecea;
		background: #f4f6f5;
		font-family: var(--__sl-font-mono);
		font-size: 0.8125rem;
		line-height: 1.6;
		color: #1d2523;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.code .f {
		color: #4b4f8f;
	}
	.code .s {
		color: #1f7a5c;
	}
	.shot figcaption,
	.term figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.then {
		margin: -0.75rem 0;
		text-align: center;
		font-size: 1.25rem;
		color: var(--arb-faint);
	}
	.dash {
		margin-top: 2rem;
	}
	.wide {
		grid-column: 1 / -1;
		width: 100%;
		max-width: 50rem;
		min-width: 0;
		margin-inline: auto;
	}

	/* the session-start terminal */
	.term {
		margin: 0;
	}
	.term-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--arb-line);
		border-bottom: 0;
		border-radius: 0.6rem 0.6rem 0 0;
		background: var(--arb-sunken);
		font-size: var(--sl-text-xs);
		color: var(--arb-muted);
	}
	.dots {
		display: inline-flex;
		gap: 0.3rem;
	}
	.dots i {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--arb-line);
	}
	.term pre {
		margin: 0;
		padding: 0.9rem 1rem;
		border: 1px solid var(--arb-line);
		border-radius: 0 0 0.6rem 0.6rem;
		background: var(--arb-surface);
		font-family: var(--__sl-font-mono);
		font-size: 0.75rem;
		line-height: 1.7;
		color: var(--arb-ink);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.term pre .h {
		font-weight: 600;
		color: var(--arb-accent);
	}
	.term pre .w {
		color: var(--arb-warn);
	}
	.term pre .m {
		color: var(--arb-muted);
	}
	.term pre .d {
		color: var(--arb-faint);
	}

	/* footer */
	.foot {
		padding-block: 3.5rem 1rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.tiles {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
	}
	@media (min-width: 50rem) {
		.tiles {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr);
			gap: 2.5rem;
		}
	}
	.tile h3 {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-base);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.tile p,
	.tile li {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.75;
		color: var(--sl-color-gray-3);
	}
	.tile ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.tile li b {
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}
	.tile .more {
		margin-top: 0.5rem;
	}
	.end {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--sl-color-hairline);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
	}
	.end p {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.end .actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
	}
</style>
